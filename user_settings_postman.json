{
	"info": {
		"_postman_id": "90f8ba46-72dc-455f-ae05-f03371debc1c",
		"name": "Smart Tourism User Settings - Complete",
		"description": "API endpoints for managing user profiles, accessibility, notifications, and preferences. These endpoints are secured and support both original profile fields and new client settings.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Fetch All Settings",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/settings",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"settings"
					]
				},
				"description": "Returns all profile, accessibility, notification, and preference data for the authenticated user."
			},
			"response": []
		},
		{
			"name": "Update Profile (Identity & Regional)",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"full_name\": \"John Doe\",\n    \"bio\": \"Tourist from France exploring Kenya.\",\n    \"language_preference\": \"fr\",\n    \"currency_preference\": \"USD\",\n    \"timezone\": \"Africa/Nairobi\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/settings/profile",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"settings",
						"profile"
					]
				},
				"description": "Update identity fields (name, bio) and regional preferences."
			},
			"response": []
		},
		{
			"name": "Update Accessibility",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"accessibility_preference\": \"Screen Reader\",\n    \"font_size\": 18,\n    \"voice_navigation\": true,\n    \"wheelchair_mode\": false,\n    \"other_needs\": {\n        \"hearing_aid_compatible\": true\n    }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/settings/accessibility",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"settings",
						"accessibility"
					]
				},
				"description": "Update accessibility preferences and inclusion settings."
			},
			"response": []
		},
		{
			"name": "Update Notifications",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email_enabled\": true,\n    \"push_enabled\": true,\n    \"sms_enabled\": false,\n    \"booking_updates_enabled\": true,\n    \"email_alerts\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/settings/notifications",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"settings",
						"notifications"
					]
				},
				"description": "Manage how and when the user receives updates."
			},
			"response": []
		},
		{
			"name": "Update Tourism Preferences",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"stay_duration_days\": 10,\n    \"budget_level\": \"high\",\n    \"pace\": \"moderate\",\n    \"interests\": [\"wildlife\", \"beaches\", \"local_food\"]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/settings/preferences",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"settings",
						"preferences"
					]
				},
				"description": "Set tourism-specific preferences for better recommendations."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_HERE"
		}
	]
}
