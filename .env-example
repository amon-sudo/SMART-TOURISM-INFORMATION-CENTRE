# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/smart_tourism_db

# ── Secrets (Flask + JWT) ─────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
JWT_SECRET_KEY=change_me_to_a_different_long_random_string

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_DEBUG=True

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5000/api/v1/auth/authorize/google to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe webhook signing secret. Local dev:
#   stripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook
# Copy the whsec_... it prints and paste below. Restart Flask after.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── Gemini (Google AI) ───────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Frontend OAuth redirect ───────────────────────────────────────────────────
# Where the Google OAuth callback redirects after a successful login.
# Tokens arrive in the URL fragment:
#   #access_token=...&refresh_token=...&user_id=...&email=...
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/profile

# ── Security headers / CORS / rate limit ──────────────────────────────────────
# Comma-separated list of allowed frontend origins. Defaults to '*' if unset.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Set 'true' in staging/prod to enable Talisman (CSP, HSTS, X-Frame-Options).
ENABLE_SECURITY_HEADERS=false

# Redis URL for Flask-Limiter counters in production. Falls back to in-memory.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Set RATELIMIT_ENABLED=false to disable rate limiting entirely (handy for
# live demos so the 5/min login limit doesn't lock out the audience).
# RATELIMIT_ENABLED=true

# Use PostGIS geography columns. Requires postgis extension in your Postgres.
USE_POSTGIS=false

# ── Navigation / Routing ──────────────────────────────────────────────────────
# OpenRouteService API key for real road-following directions on
# /api/v1/navigation/route. Get a free key at https://openrouteservice.org
# (2000 requests/day on the free tier). When unset, /navigation/route falls
# back to a straight-line haversine estimate.
# ORS_API_KEY=eyJ...

# ── M-Pesa Daraja (optional) ──────────────────────────────────────────────────
# https://developer.safaricom.co.ke -> My Apps
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
